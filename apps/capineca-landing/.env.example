# Endereço do webhook de geração no Make (segredo: configurar somente no ambiente)
MAKE_PERSONALIZATION_WEBHOOK_URL=

# URL pública atual do Site. Atualize para https://www.capineca.com.br após o registro e a configuração do domínio.
NEXT_PUBLIC_SITE_URL=

# Segredo compartilhado entre o site e o Make, usado no envio e no callback
MAKE_WEBHOOK_SECRET=

# Segredo para o cenário do Make enviar novos modelos ao feed
MODEL_FEED_WEBHOOK_SECRET=

# E-mails autorizados no painel, separados por vírgula
ADMIN_EMAILS=

# Preço unitário em centavos. 1990 = R$ 19,90
MUG_UNIT_PRICE_CENTS=1990

# Integração do personalizador empresarial com o projeto Supabase Dona Antônia existente
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Número exclusivo de WhatsApp da CapiNeca em formato internacional, somente dígitos (ex.: 5565999999999)
CAPINECA_WHATSAPP_NUMBER=

# Repositório/branch onde o admin publica as imagens públicas do site
CAPINECA_GITHUB_REPO=osvaldosereia/canecafacil
CAPINECA_GITHUB_BRANCH=main

# Segredo do servidor para criptografar o token do GitHub armazenado no D1
CAPINECA_GITHUB_ENCRYPTION_KEY=

# Chaves antigas do checkout. O fluxo público da CapiNeca não cobra online.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Melhor Envio: use sandbox durante os testes e production somente após homologação
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_ACCESS_TOKEN=
STORE_ORIGIN_POSTAL_CODE=
STORE_SUPPORT_EMAIL=
